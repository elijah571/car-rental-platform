# Copy these values into the repository-root .env.local for local production builds,
# or set them in Vercel Project Settings → Environment Variables.
# Replace the host with the URL of the combined Render backend service.
VITE_AUTH_API_URL=https://your-backend.onrender.com/api/auth
VITE_CAR_API_URL=https://your-backend.onrender.com/api/cars
VITE_BOOKING_API_URL=https://your-backend.onrender.com/api/bookings

# Public Stripe key only. Never put Stripe secret or webhook keys in a VITE_ variable.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
