# Local PostgreSQL settings. Compose sets POSTGRES_HOST=postgres and port 5432 internally.
POSTGRES_USER=car_rental_dev
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=car_rental
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Locally signed auth tokens. Generate independent secrets with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_another_random_secret_at_least_32_characters
JWT_ACCESS_EXPIRE=50m
JWT_REFRESH_EXPIRE=7d
# Local Compose uses its Redis container. Production can set REDIS_URL to a TLS cloud Redis URL.
REDIS_URL=redis://127.0.0.1:6380/0
REDIS_CLOUD_URL=
# Optional Compose override for production; defaults to the local Redis container.
AUTH_REDIS_URL=
# Accounts registered with these emails receive the platform-admin role after email verification.
PLATFORM_ADMIN_EMAILS=elijahfx43@gmail.com
AUTH_ALLOW_DEV_VERIFICATION_CODE=true

# Stripe test mode. Set STRIPE_WEBHOOK_SECRET from `stripe listen`.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Generate distinct random values for each internal service boundary.
PAYMENT_SERVICE_API_KEY=replace_with_a_long_random_value
RECEIPT_SERVICE_API_KEY=replace_with_a_long_random_value
NOTIFICATION_SERVICE_API_KEY=replace_with_a_long_random_value
PAYMENT_TO_BOOKING_API_KEY=replace_with_a_long_random_value
AUTH_SERVICE_API_KEY=replace_with_a_long_random_value

# Internal service locations for local development.
CAR_SERVICE_URL=http://127.0.0.1:8002
BOOKING_SERVICE_URL=http://127.0.0.1:8001
RECEIPT_SERVICE_URL=http://127.0.0.1:8005
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8003

# SMTP for account verification and notification-service email delivery.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
EMAIL_USER=replace_with_smtp_username
EMAIL_PASS=replace_with_smtp_password
EMAIL_FROM=

# Local browser origin permitted by auth, car, and booking APIs.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend settings. Leave API URLs blank to use the Vite development proxy.
VITE_AUTH_API_URL=
VITE_CAR_API_URL=
VITE_BOOKING_API_URL=
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
